FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    FPL_RUNNER_BIND=0.0.0.0 \
    FPL_RUNNER_PORT=8787 \
    FPL_RUNNER_ASSET_DIR=/app/public \
    FPL_PERFORMANCE_BASELINE_PATH=/app/data/state/performance-baseline.json

WORKDIR /app

COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir .

COPY public/standard-fpl-runner.html public/standard-fpl-runner.js public/standard-fpl-viewer.js public/standard-fpl-viewer.css ./public/
COPY data/state/performance-baseline.json ./data/state/performance-baseline.json

RUN addgroup --system app && adduser --system --uid 10001 --ingroup app app
USER app

EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import json,urllib.request; assert json.load(urllib.request.urlopen('http://127.0.0.1:8787/health', timeout=3))['status'] == 'ok'"

CMD ["fpl-toolkit-runner"]
